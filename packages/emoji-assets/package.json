{
  "name": "@as/emoji-assets",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist",
    "assets"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./*": "./assets/*.svg"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && cp -R assets dist/assets"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.5.4"
  }
}
